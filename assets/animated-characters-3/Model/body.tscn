[sub_resource type="GDScript" id="GDScript_0hbbm"]
resource_name = "npc"
script/source = "extends Node3D

@export var skin : CompressedTexture2D
# maybe bad that it's hardcoded, but eh
var all_skins : Array[CompressedTexture2D] = [
	preload(\"res://assets/animated-characters-3/Skins/hoboFemaleA.png\"),
	preload(\"res://assets/animated-characters-3/Skins/hoboFemaleB.png\"),
	preload(\"res://assets/animated-characters-3/Skins/hoboMaleA.png\"),
	preload(\"res://assets/animated-characters-3/Skins/hoboMaleB.png\"),
	preload(\"res://assets/animated-characters-3/Skins/humanFemaleA.png\"),
	preload(\"res://assets/animated-characters-3/Skins/humanFemaleB.png\"),
	preload(\"res://assets/animated-characters-3/Skins/humanMaleA.png\"),
	preload(\"res://assets/animated-characters-3/Skins/humanMaleB.png\")
]

func _ready() -> void:
	if ! all_skins.has(skin):
		skin = all_skins.pick_random()
	
	var skinMaterial = StandardMaterial3D.new()
	skinMaterial.albedo_texture = skin
	$Root/Skeleton3D/characterMedium.set_surface_override_material(0, skinMaterial)
"

